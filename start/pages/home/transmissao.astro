---
import Layout from '../../views/layouts/Layout.astro';
import '../../../recursos/css/pages/home/transmissao.css';
---
<Layout title="FutureBeyond | Inicialização de sessão" description="Inicialização de acesso ao portal FutureBeyond.">
  <main class="signal-home">
    <section class="signal-console" aria-labelledby="signal-title">
      <header class="signal-console__titlebar">
        <span aria-hidden="true" class="signal-console__lights"><i></i><i></i><i></i></span>
        <span>FB-OS / SESSION.INIT</span>
        <span aria-hidden="true">_ □ ×</span>
      </header>
      <div class="signal-console__body">
        <p class="signal-console__label">&gt; inicializando sessão...</p>
        <h1 id="signal-title">Acesso concedido<span class="signal-console__cursor" aria-hidden="true">_</span></h1>
        <div class="signal-console__code" aria-label="Informações da sessão">
          <p><span>01</span> const visitante = <strong>"convidado"</strong>;</p>
          <p><span>02</span> conexão.<em>estabelecer</em>();</p>
          <p><span>03</span> sistema.<em>verificar</em>(<b>"integridade"</b>);</p>
          <p class="signal-console__fault"><span>04</span> /* erro: registro parcialmente recuperado */</p>
          <p><span>05</span> sessão.<em>continuar</em>();</p>
        </div>
        <p class="signal-console__status"><span aria-hidden="true">●</span> CONEXÃO ESTABELECIDA</p>
        <a class="signal-console__enter" href="/home">Continuar para o site <span aria-hidden="true">↗</span></a>
      </div>
      <footer class="signal-console__footer"><span>FB-OS // CONVIDADO</span><a href="/">← voltar</a></footer>
    </section>
  </main>
</Layout>
