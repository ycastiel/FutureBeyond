---
import Layout from '../../views/layouts/Layout.astro';
import TerminalTranscricao from '../../views/componentes/alienados/TerminalTranscricao.astro';
import '../../../recursos/css/pages/alienados/alienados.css';
import '../../../recursos/css/pages/alienados/video.css';

// MP4s oficiais no R2. URL temporária de testes (r2.dev), NÃO usar na produção.
// Quando o subdomínio de mídia estiver pronto, altere apenas esta constante.
const baseDosVideos = 'https://pub-90cad55344be4a7ea61b85c6b701136b.r2.dev/h1-midias/alienados';
const urlDoEpisodio = (numero: number): string =>
  `${baseDosVideos}/${encodeURIComponent(`Alienados - EP${numero}.mp4`)}`;

type Episodio = {
  numero: string;
  titulo: string | null;
  video: string;
  legenda: string | null;
  descricao: string;
};

const episodios: Episodio[] = [
  {
    numero: '01',
    titulo: 'Teorias da Conspiração',
    video: urlDoEpisodio(1),
    legenda: '/videos/legendas/alienados/ep-01.vtt',
    descricao: 'Nesse episódio nossos produtores conversam sobre as conspirações do mundo, envolvendo Big Techs, ordens mundiais e conceitos que todos levam como verdade mas talvez deveriam ser investigados a fundo.',
  },
  {
    numero: '02',
    titulo: 'Trabalho',
    video: urlDoEpisodio(2),
    legenda: '/videos/legendas/alienados/ep-02.vtt',
    descricao: 'Nesse episódio nossos produtores conversam sobre teologia e o verdadeiro significado da fé, além de fazerem uma análise profunda sobre os prós e contras do modelo de trabalho home office.',
  },
  {
    numero: '03',
    titulo: 'Planetas',
    video: urlDoEpisodio(3),
    legenda: '/videos/legendas/alienados/ep-03.vtt',
    descricao: 'Nesse episódio nossos produtores conversam sobre a magnitude de nosso sistema solar e comentam sobre a estrutura do planeta Terra, além de resolverem alguns assuntos pessoais entre si.',
  },
  {
    numero: '04',
    titulo: 'Aliens',
    video: urlDoEpisodio(4),
    legenda: '/videos/legendas/alienados/ep-04.vtt',
    descricao: 'Nesse episódio nossos produtores conversam sobre as inúmeras aparições extraterrestres em solo terráqueo, fazendo demonstrações práticas de como eles agem, além de adicionar comentários sobre a visão de diferentes nações sobre o assunto. Além disso, esse episódio finaliza a série Alienados!',
  },
];

// O roteiro ainda não define qual mídia de trote será usada no EP4.
// Quando o cliente enviar o arquivo, coloque-o em recursos/publico/ e configure abaixo.
// Exemplos: arquivo: '/videos/extras/ep4-trote.mp4', tipo: 'video'
//           arquivo: '/videos/extras/ep4-trote.mp3', tipo: 'audio'
const troteExtraEP4: { arquivo: string; tipo: 'video' | 'audio' } = {
  arquivo: '',
  tipo: 'video',
};
const possuiTroteExtra = troteExtraEP4.arquivo.trim().length > 0;
---
<Layout title="H1Produtora | Alienados" description="Alienados, o podcast da H1 Produtora.">
  <main class="h1-alienados">
    <div class="h1-alienados__shell">
      <div class="h1-alienados__chrome"><span aria-hidden="true">● ● ●</span><span>H1 PRODUTORA / ALIENADOS</span><span>ONLINE</span></div>
      <nav class="h1-alienados__nav" aria-label="Navegação da produtora">
        <a href="/home">⌂ HOME</a><a href="/blog/sobre">✿ SOBRE</a><a href="/forum">✉ FÓRUM</a><span aria-current="page">◉ ALIENADOS</span>
      </nav>
      <header class="h1-alienados__hero">
        <div>
          <p>◉ UMA PRODUÇÃO H1</p>
          <h1>Alienados</h1>
          <p>Nós da H1 temos o prazer de trazer ao público nosso novo podcast, o Alienados. Nosso objetivo é trazer nossa audiência para mais próxima de nosso time, mostrando quem somos e como pensamos por meio de discussões e assuntos diversos.</p>
        </div>

        <div class="h1-alienados__hero-art" aria-hidden="true">
          <span class="h1-alienados__badge h1-alienados__badge--rec">● REC / H1</span>
          <span class="h1-alienados__badge h1-alienados__badge--label">IDENTIDADE VISUAL</span>
          <span class="h1-alienados__spark h1-alienados__spark--a">✦</span>
          <span class="h1-alienados__spark h1-alienados__spark--b">✧</span>
          <span class="h1-alienados__spark h1-alienados__spark--c">✦</span>
          <span class="h1-alienados__frequency" aria-hidden="true">▂ ▅ ▃ ▆ ▂ ▄ ▇ ▃</span>
          <img src="/imagens/h1/h1-vertical.png" alt="" width="1288" height="621" decoding="async" />
          <span class="h1-alienados__frame-note">H1-TC // AUDIO DEPT.</span>
        </div>
      </header>
      <div class="h1-alienados__episodes">
        <h2>✦ Episódios</h2>
        {episodios.map(ep => (
          <section class="h1-alienados__episode" aria-label={`Episódio ${ep.numero}`}>
            <div class="h1-alienados__episode-title"><span>EP. {ep.numero}</span><h3>{ep.titulo ?? `Episódio ${Number(ep.numero)}`}</h3></div>
            <TerminalTranscricao numero={ep.numero} titulo={ep.titulo} video={ep.video} legenda={ep.legenda} />
            <p class="h1-alienados__episode-description">
              {ep.numero === '04' ? (
                <>
                  {ep.descricao.split('demonstrações práticas')[0]}
                  <button
                    type="button"
                    class="h1-alienados__extra-trigger"
                    data-alienados-extra-open
                    aria-haspopup="dialog"
                    aria-controls="alienados-extra-ep4"
                    title="Ver demonstração prática extra"
                  ><em>demonstrações práticas</em></button>
                  {ep.descricao.split('demonstrações práticas')[1]}
                </>
              ) : ep.descricao}
            </p>
          </section>
        ))}
      </div>
      <footer class="h1-alienados__footer"><span>H1 PRODUTORA × H1Produtora</span><a href="/home">← VOLTAR PARA A CENTRAL</a></footer>
    </div>
    <dialog
      id="alienados-extra-ep4"
      class="h1-alienados__extra-dialog"
      aria-labelledby="alienados-extra-title"
      aria-describedby="alienados-extra-description"
      data-alienados-extra-dialog
    >
      <header class="h1-alienados__extra-header">
        <span aria-hidden="true">●</span>
        <h2 id="alienados-extra-title">H1 / ARQUIVO EXTRA — EP. 04</h2>
        <button type="button" class="h1-alienados__extra-close" data-alienados-extra-close aria-label="Fechar janela">×</button>
      </header>
      <div class="h1-alienados__extra-body">
        <p id="alienados-extra-description" class="h1-alienados__extra-caption">Demonstrações práticas — material complementar do Alienados.</p>
        {possuiTroteExtra ? (
          troteExtraEP4.tipo === 'video' ? (
            <video controls preload="none" playsinline src={troteExtraEP4.arquivo} aria-label="Reproduzir trote extra do episódio 4">Seu navegador não suporta vídeo.</video>
          ) : (
            <audio controls preload="none" src={troteExtraEP4.arquivo} aria-label="Reproduzir trote extra do episódio 4">Seu navegador não suporta áudio.</audio>
          )
        ) : (
          <div class="h1-alienados__extra-pendente" role="status">
            <span aria-hidden="true">▣</span>
            <p>MÍDIA EM PREPARAÇÃO</p>
            <small>O trote adicional ainda será escolhido pela equipe da H1.</small>
          </div>
        )}
      </div>
    </dialog>
  </main>
</Layout>

<script>
  import '../../../recursos/javascript/componentes/visualizadores/TranscricaoAlienados.ts';

  function iniciarExtraEP4(): void {
    const botaoAbrir = document.querySelector<HTMLButtonElement>('[data-alienados-extra-open]');
    const janela = document.querySelector<HTMLDialogElement>('[data-alienados-extra-dialog]');
    if (!botaoAbrir || !janela || botaoAbrir.dataset.extraLigado === 'sim') return;
    botaoAbrir.dataset.extraLigado = 'sim';

    botaoAbrir.addEventListener('click', () => {
      // Não deixar o episódio principal tocando por trás da mídia extra.
      document.querySelectorAll<HTMLVideoElement>('[data-transcricao-video]').forEach((video) => video.pause());
      if (!janela.open) janela.showModal();
    });
    janela.querySelector<HTMLButtonElement>('[data-alienados-extra-close]')
      ?.addEventListener('click', () => janela.close());
    janela.addEventListener('click', (evento) => {
      if (evento.target === janela) janela.close();
    });
    janela.addEventListener('close', () => {
      janela.querySelectorAll<HTMLMediaElement>('audio, video').forEach((midia) => midia.pause());
      if (botaoAbrir.isConnected) botaoAbrir.focus();
    });
  }

  document.addEventListener('astro:page-load', iniciarExtraEP4);
  iniciarExtraEP4();
</script>
