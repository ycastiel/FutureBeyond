---
import Layout from '../views/layouts/Layout.astro';
---

<Layout title="FutureBeyond | Home">
  <main class="home-preview">
    <div class="home-preview__window">
      <p class="home-preview__eyebrow">TRANSMISSÃO ESTABELECIDA // 001</p>
      <h1>Bem-vindo ao FutureBeyond.</h1>
      <p>Você entrou como convidado. A central de navegação será construída aqui.</p>
      <a href="/">← Voltar ao portal</a>
    </div>
  </main>
</Layout>

<style>
  .home-preview {
    min-height: 100svh;
    display: grid;
    place-items: center;
    padding: 1.5rem;
    background: radial-gradient(circle at 50% 20%, var(--color-violet-800), var(--color-void) 70%);
  }

  .home-preview__window {
    width: min(100%, 580px);
    padding: clamp(1.5rem, 6vw, 3rem);
    border: 1px solid var(--color-violet-300);
    border-radius: var(--radius-window);
    background: rgba(44, 14, 68, .78);
    box-shadow: var(--shadow-window);
  }

  .home-preview__eyebrow {
    color: var(--color-cyan);
    font: 700 .75rem var(--font-mono);
    letter-spacing: .12em;
  }

  h1 { margin: 1rem 0; font-size: clamp(1.8rem, 6vw, 2.8rem); }
  p { line-height: 1.7; }
  a { display: inline-block; margin-top: 1rem; color: var(--color-lavender); font-weight: 700; }
</style>
