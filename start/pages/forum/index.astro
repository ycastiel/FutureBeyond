---
<Layout title="FutureBeyond | Fórum da H1" description="Conversas e anúncios no fórum da H1 Produtora.">
  <main class="h1-forum" id="topo">
    <div class="h1-forum__shell">
      <header class="h1-forum__browser">
        <div class="h1-forum__titlebar"><span aria-hidden="true">● ● ●</span><span>FutureBeyond.net / H1 Fórum</span><span>ONLINE</span></div>
        <div class="h1-forum__banner">
          <div><p>✧ H1 PRODUTORA — COMUNIDADE</p><h1>Nosso <em>fórum</em> ♡</h1><p>Discussões sobre nossas produções e perguntas da comunidade.</p></div>
          <img src="/imagens/h1/h1-horizontal.png" alt="H1 Produtora" width="1991" height="400" />
        </div>
        <nav class="h1-forum__nav" aria-label="Navegação do site">
          <a href="/home">⌂ HOME</a><a href="/sobre">✿ SOBRE</a>
          <span aria-current="page">✉ FÓRUM</span><a href="/alienados">◉ ALIENADOS</a>
        </nav>
      </header>
      <div class="h1-forum__layout">
        <aside class="h1-forum__sidebar" aria-label="Menu do fórum">
          <section class="h1-forum__widget"><h2>✧ Área de visitante</h2><p>Você está acessando como convidado.</p><a href="/">Ir para o login ↗</a></section>
          <section class="h1-forum__widget"><h2>✿ Navegação rápida</h2>
            <ul>{topicos.map((topico) => <li><a href={`#${topico.id}`}>{topico.titulo}</a></li>)}</ul>
          </section>
        </aside>
        <div class="h1-forum__main">
          <p class="h1-forum__readonly">◈ ARQUIVO DE DISCUSSÕES · MODO LEITURA</p>
          {topicos.map((topico, i) => (
            <section class="h1-forum__topic" id={topico.id} aria-labelledby={`titulo-${topico.id}`}>
              <div class="h1-forum__topic-head"><span>▣ TÓPICO {String(i+1).padStart(2,'0')}</span><span>{topico.mensagens.length} MENSAGENS</span></div>
              <h2 id={`titulo-${topico.id}`}>{topico.titulo}</h2>
              <div class="h1-forum__posts">
                {topico.mensagens.map((msg, j) => (
                  <article class="h1-forum__post">
                    <div class="h1-forum__author"><span class="h1-forum__avatar" aria-hidden="true">{msg.autor.charAt(0).toUpperCase()}</span><strong>{msg.autor}</strong><small>#{String(j+1).padStart(2,'0')}</small></div>
                    <p>{msg.texto}</p>
                  </article>
                ))}
              </div>
            </section>
          ))}
        </div>
      </div>
      <footer class="h1-forum__footer"><span>H1 PRODUTORA × FUTUREBEYOND</span><a href="#topo">↑ TOPO</a></footer>
    </div>
  </main>
</Layout>