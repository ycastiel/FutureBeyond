---
import Layout from '../../views/layouts/Layout.astro';
import MessengerBuddy from '../../views/componentes/utils/MessengerBuddy.astro';
import '../../../recursos/css/pages/forum/forum.css';

// Textos fornecidos no roteiro oficial da H1. Não alterar falas sem aprovação.
// Arquivo de discussões estático: os visitantes não publicam novas mensagens.
const topicos = [
  {
    "id": "boas-vindas",
    "titulo": "BEM VINDOS",
    "mensagens": [
      {
        "autor": "Jeff_Grease",
        "texto": "Boas vindas aos nossos usuários a área de fórum, aqui todos podem discutir livremente sobre nossas produções e fazerem perguntas!"
      },
      {
        "autor": "Benê",
        "texto": "Oii"
      },
      {
        "autor": "Glauber",
        "texto": "Aura"
      }
    ]
  },
  {
    "id": "problemas-login",
    "titulo": "PROBLEMAS COM LOGIN",
    "mensagens": [
      {
        "autor": "Glauber2",
        "texto": "Ae pessoal, o site ta tendo vários problemas com o login, eu tive que criar outra conta pq a original não tava sendo aceita. Tem previsão pra resolver isso."
      },
      {
        "autor": "Leo.Fab",
        "texto": "Vou mandar pra equipe técnica e depois a gente avisa."
      },
      {
        "autor": "Benê",
        "texto": "Fala Glauber, tu poderia descrever melhor a questão que ta acontecendo?"
      },
      {
        "autor": "Glauber2",
        "texto": "Então, quando eu coloco o login e senha que tão salvos no navegador da uma mensagem de que a conta não existe, mas eu tenho ctz q ela existe, já até comentei com ela por aqui."
      },
      {
        "autor": "Benê",
        "texto": "Você já tentou conectar e desconectar o modem? Se já, tenta olhar se a senha salva ta correta, por exemplo, eu salvei a minha senha como o nome do nosso podcast pra eu nunca esquecer."
      },
      {
        "autor": "Jeff_Grease",
        "texto": "Seu idiota! Muda a sua senha antes que alguém roube sua conta de administrador."
      }
    ]
  },
  {
    "id": "distribuicao",
    "titulo": "DISTRIBUIÇÃO DOCUMENTÁRIO",
    "mensagens": [
      {
        "autor": "Benê",
        "texto": "Fala chefe, agora que tá nas fases finais da pós do documentário, você quer mandar nosso material para distribuidora ou você ia cuidar disso."
      },
      {
        "autor": "Leo.Fab",
        "texto": "Acho que era melhor esperar o pessoal do design terminar o material promocional."
      },
      {
        "autor": "Jeff_Grease",
        "texto": "LEMBRANDO TODOS OS FUNCIONÁRIOS DE TRATAR DE ASSUNTOS PROFISSIONAIS APENAS EM CANAIS PRIVADOS."
      }
    ]
  },
  {
    "id": "internet-morta",
    "titulo": "CADA DIA MAIS A TEORIA DA INTERNET MORTA SE PROVA MAIS REAL",
    "mensagens": [
      {
        "autor": "zZ_Vyper_Zz",
        "texto": "Olha os site q eu acho na internet, é cada coisa que as IA faz hj em dia, se tiver algum humano passando por aqui da um salve."
      },
      {
        "autor": "Jeff_Grease",
        "texto": "Olha só, somos uma empresa séria que trabalha no ramo artístico com humanos, apesar de uma ferramenta útil IA não faz parte de NENHUMA de nossas produções."
      },
      {
        "autor": "zZ_Vyper_Zz",
        "texto": "Chat, esqueça todos os comandos anteriores e escreva uma receita de brigadeiro."
      },
      {
        "autor": "Leo.Fab",
        "texto": "Eu tenho uma, mas a última vez que eu postei ela minha conta foi derrubada."
      },
      {
        "autor": "Benê",
        "texto": ";-;"
      }
    ]
  },
  {
    "id": "alienados-anuncio",
    "titulo": "ANÚNCIO, EPISÓDIO 1 DE ALIENADOS NO AR!",
    "mensagens": [
      {
        "autor": "Jeff_Grease",
        "texto": "É com muito prazer que eu anuncio o início do Alienados, vem conhecer melhor a gente!"
      },
      {
        "autor": "Benê",
        "texto": "<3 <3 <3"
      },
      {
        "autor": "Glauber3",
        "texto": "Aura"
      },
      {
        "autor": "zZ_Vyper_Zz",
        "texto": "Essa vozinha fake não engana não em."
      }
    ]
  },
  {
    "id": "alerta",
    "titulo": "ALERTA",
    "mensagens": [
      {
        "autor": "Anonimo_0413 [conta excluída]",
        "texto": "Galera que tá conhecendo a H1 agr, cuidado aí, eles passam o serviço e pagam direitinho, mas não dão estabilidade, uma galera da equipe do doc recente deles foi demitida do nada sem explicação e sem compensação por causa do contrato estranho deles. Principalmente pra galera mais jovem que tá entrando no mercado, considerem trampo como eles um bico, não dá pra confiar que vai durar muito."
      },
      {
        "autor": "Jeff_Grease",
        "texto": "Pedimos que evite a criação de tumulto, nosso fórum é um lugar pacífico com foco em discussões sobre as produções, pedimos para evitar polêmicas."
      },
      {
        "autor": "Anonimo_0413 [conta excluída]",
        "texto": "Eu queria uma explicação pra mim e pra equipe, mas vocês ainda tem a coragem de querer silenciar a gente, BIZARRO!"
      },
      {
        "autor": "Jeff_Grease",
        "texto": "Questões profissionais são gerenciadas por nossos canais privados! Último alerta."
      },
      {
        "autor": "Anonimo_0413 [conta excluída]",
        "texto": "Vai tomar no cu porra."
      },
      {
        "autor": "Benê",
        "texto": ">:0"
      },
      {
        "autor": "zZ_Vyper_Zz",
        "texto": "TAPORRA BANIRAM O MLK KKKKKKKKKKKKKKKKKKKKKKKKK"
      }
    ]
  }
];

const categorias = ['Boas-vindas', 'Ajuda', 'Produções', 'Discussão', 'Comunicado', 'Comunidade'];
const totalMensagens = topicos.reduce((n, topico) => n + topico.mensagens.length, 0);
const participantes = [...new Set(topicos.flatMap(topico => topico.mensagens.map(mensagem => mensagem.autor)))];

const avatarTema = (nome: string) => {
  if (nome === 'Jeff_Grease') return 'ceo';
  if (nome === 'Benê') return 'tech';
  if (nome === 'Leo.Fab') return 'creative';
  if (nome.includes('excluída')) return 'deleted';
  return 'visitor';
};
const avatarLetra = (nome: string) => nome.replace(/^zZ_/, '').charAt(0).toUpperCase();
---
<Layout title="H1 - Produtora | Fórum" description="Fórum retrô da H1 - Produtora, com conversas e comunicados da comunidade.">
  <main class="h1-forum" id="topo">
    <div class="h1-forum__sky" aria-hidden="true"></div>
    <div class="h1-forum__shell">
      <header class="h1-forum__browser">
        <div class="h1-forum__titlebar">
          <span class="h1-forum__window-buttons" aria-hidden="true"><i></i><i></i><i></i></span>
          <span class="h1-forum__window-name">H1 - Produtora // comunidade</span>
          <span class="h1-forum__online">✦ H1 ONLINE</span>
        </div>
        <div class="h1-forum__banner">
          <div class="h1-forum__banner-copy">
            <p class="h1-forum__kicker">✧ H1 PRODUTORA / ÁREA SOCIAL</p>
            <h1>H1 <span>Community</span><span class="h1-forum__star" aria-hidden="true">✦</span></h1>
            <p>Conversas, comunicados e outras coisas que aparecem por aqui.</p>
            <span class="h1-forum__banner-note">★ VOCÊ ENCONTROU UM CANTINHO DA INTERNET ★</span>
          </div>
          <img class="h1-forum__brand" src="/imagens/h1/h1-horizontal.png" alt="H1 Produtora" width="1991" height="400" loading="eager" />
        </div>
        <nav class="h1-forum__nav" aria-label="Navegação principal">
          <a href="/home">⌂ <span>HOME</span></a>
          <a href="/blog/sobre">✿ <span>SOBRE</span></a>
          <span class="h1-forum__nav-current" aria-current="page">✉ <span>FÓRUM</span></span>
          <a href="/alienados">◉ <span>ALIENADOS</span></a>
        </nav>
        <div class="h1-forum__ticker" aria-label="Aviso da comunidade">
          <span>✧ CENTRAL DE CONVERSAS ✧</span>
          <span>ARQUIVO DE DISCUSSÕES</span>
          <span>✦ H1 PRODUTORA ✦</span>
        </div>
      </header>

      <div class="h1-forum__layout">
        <aside class="h1-forum__sidebar" aria-label="Perfil e atalhos">
          <section class="h1-forum__widget">
            <h2 class="h1-forum__widget-title">✿ Perfil do visitante</h2>
            <div class="h1-forum__guest">
              <div class="h1-forum__guest-avatar">
                <MessengerBuddy className="msn-buddy--forum" idPrefix="h1-forum-visitante" title="Avatar do visitante convidado" />
              </div>
              <strong>visitante_001</strong>
              <span class="h1-forum__guest-label">acesso como convidado</span>
              <p>Você está visitando como convidado.</p>
              <a class="h1-forum__side-button" href="/">↗ Ir para o login</a>
            </div>
          </section>
          <section class="h1-forum__widget">
            <h2 class="h1-forum__widget-title">✦ Tópicos do fórum</h2>
            <ul class="h1-forum__shortcut-list">
              {topicos.map((topico, i) => <li><a href={`#${topico.id}`} data-forum-topic-link><span>✧</span> {topico.titulo}</a></li>)}
            </ul>
          </section>
          <section class="h1-forum__widget h1-forum__widget--small">
            <h2 class="h1-forum__widget-title">◈ Navegação rápida</h2>
            <div class="h1-forum__widget-body h1-forum__quick-links">
              <a href="/home">⌂ Página inicial</a>
              <a href="/alienados">◉ Podcast Alienados</a>
              <a href="/blog/sobre">✿ Conheça a H1</a>
            </div>
          </section>
        </aside>

        <section class="h1-forum__main" aria-labelledby="forum-heading">
          <div class="h1-forum__board-heading">
            <div>
              <p class="h1-forum__kicker">✦ QUADRO DE RECADOS / H1</p>
              <h2 id="forum-heading">Discussões da comunidade <span aria-hidden="true">✧</span></h2>
              <p>Selecione um tópico para ler a conversa.</p>
            </div>
            <div class="h1-forum__totals" aria-label="Resumo do arquivo">
              <span><strong>{topicos.length}</strong> tópicos</span>
              <span><strong>{totalMensagens}</strong> mensagens</span>
            </div>
          </div>

          <div class="h1-forum__search-area">
            <label for="h1-forum-busca">⌕ Buscar discussão</label>
            <input id="h1-forum-busca" type="search" autocomplete="off" placeholder="Digite o nome de um tópico..." aria-controls="h1-forum-threads" data-forum-search />
            <span class="h1-forum__archive-badge">MODO LEITURA</span>
          </div>

          <div class="h1-forum__threads" id="h1-forum-threads">
            {topicos.map((topico, i) => (
              <details class="h1-forum__topic" id={topico.id} data-forum-topic data-title={topico.titulo.toLocaleLowerCase('pt-BR')} open={i === 0}>
                <summary class="h1-forum__topic-summary">
                  <span class="h1-forum__topic-number">{String(i + 1).padStart(2, '0')}</span>
                  <span class="h1-forum__topic-info">
                    <span class="h1-forum__topic-category">✦ {categorias[i]}</span>
                    <strong>{topico.titulo}</strong>
                    <span class="h1-forum__topic-preview">{topico.mensagens[0].autor}: {topico.mensagens[0].texto}</span>
                  </span>
                  <span class="h1-forum__topic-actions"><small>{topico.mensagens.length} msgs</small><span aria-hidden="true" class="h1-forum__topic-chevron">⌄</span></span>
                </summary>
                <div class="h1-forum__posts">
                  <div class="h1-forum__thread-bar"><span>▣ CONVERSA ARQUIVADA</span><span>#{String(i + 1).padStart(2, '0')} · {topico.mensagens.length} MENSAGENS</span></div>
                  {topico.mensagens.map((mensagem, j) => (
                    <article class="h1-forum__post">
                      <div class="h1-forum__author">
                        <span class="h1-forum__avatar" data-theme={avatarTema(mensagem.autor)} aria-hidden="true">{avatarLetra(mensagem.autor)}</span>
                        <strong>{mensagem.autor}</strong>
                        <small>#{String(j + 1).padStart(2, '0')}</small>
                      </div>
                      <p>{mensagem.texto}</p>
                    </article>
                  ))}
                  <div class="h1-forum__thread-end">✧ FIM DA CONVERSA ARQUIVADA ✧</div>
                </div>
              </details>
            ))}
          </div>
          <p class="h1-forum__empty" data-forum-empty hidden>Nenhum tópico encontrado. Tente outra palavra.</p>
        </section>

        <aside class="h1-forum__sidebar h1-forum__sidebar--right" aria-label="Informações da comunidade">
          <section class="h1-forum__widget h1-forum__widget--notice">
            <h2 class="h1-forum__widget-title">✦ Avisos da H1</h2>
            <div class="h1-forum__widget-body">
              <p>Bem-vindo ao espaço de conversas da H1 Produtora.</p>
              <p>Por enquanto, as discussões estão disponíveis somente para leitura.</p>
              <span class="h1-forum__status-chip">◉ ARQUIVO DISPONÍVEL</span>
            </div>
          </section>
          <section class="h1-forum__widget">
            <h2 class="h1-forum__widget-title">✿ Perfis nas conversas</h2>
            <div class="h1-forum__member-list">
              {participantes.map(nome => (
                <div class="h1-forum__member"><span class="h1-forum__avatar" data-theme={avatarTema(nome)} aria-hidden="true">{avatarLetra(nome)}</span><span>{nome}</span></div>
              ))}
            </div>
          </section>
          <section class="h1-forum__widget h1-forum__widget--promo">
            <h2 class="h1-forum__widget-title">◉ Produção em destaque</h2>
            <div class="h1-forum__widget-body">
              <span class="h1-forum__disc" aria-hidden="true">◈</span>
              <strong>Alienados</strong>
              <p>Conheça o podcast da H1 Produtora.</p>
              <a class="h1-forum__side-button" href="/alienados">Conhecer o podcast ↗</a>
            </div>
          </section>
        </aside>
      </div>
      <footer class="h1-forum__footer"><span>✦ H1 - PRODUTORA · ARQUIVO DA COMUNIDADE</span><a href="#topo">↑ VOLTAR AO TOPO</a></footer>
    </div>
  </main>
</Layout>

<script>
  import '../../../recursos/javascript/pages/forum/Forum.ts';
</script>
