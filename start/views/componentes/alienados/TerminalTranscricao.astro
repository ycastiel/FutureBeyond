---
interface Props {
  numero: string;
  titulo: string | null;
  video?: string | null;
  legenda?: string | null;
}

const { numero, titulo, video = null, legenda = null } = Astro.props;
const temVideo = Boolean(video);
const temLegenda = Boolean(video && legenda);
const descricao = titulo ? `Episódio ${numero}: ${titulo}` : `Episódio ${numero}`;
---
<div class="h1-alienados__midia" data-transcricao-midia>
  <div class="h1-alienados__reprodutor">
    <div class="h1-alienados__reprodutor-info">
      <span aria-hidden="true">▶</span>
      <span>VÍDEO OFICIAL / EP. {numero}</span>
    </div>
    {temVideo ? (
      <video
        class="h1-alienados__video"
        data-transcricao-video
        controls
        playsinline
        preload="none"
        poster="/imagens/h1/h1-visualizer-fundo.webp"
        src={video!}
        aria-label={`Reproduzir vídeo oficial de ${descricao}`}
      >
        {temLegenda && <track
          data-transcricao-track
          kind="subtitles"
          src={legenda!}
          srclang="pt-BR"
          label="Português (Brasil)"
        />}
        Seu navegador não suporta reprodução de vídeo.
      </video>
    ) : (
      <div class="h1-alienados__reprodutor-offline" role="status">VÍDEO INDISPONÍVEL</div>
    )}
    {temLegenda && (
      <button
        type="button"
        class="h1-alienados__legenda-toggle"
        data-transcricao-cc
        aria-pressed="false"
        aria-label={`Mostrar ou ocultar legendas no vídeo do episódio ${numero}`}
      >
        CC DESLIGADO
      </button>
    )}
  </div>

  <section
    class="h1-alienados__transcricao"
    aria-label={`Terminal de transcrição: ${descricao}`}
    data-transcricao-terminal
  >
    <div class="h1-alienados__transcricao-barra">
      <div class="h1-alienados__transcricao-identidade">
        <span class="h1-alienados__transcricao-luzes" aria-hidden="true"><i></i><i></i><i></i></span>
        <strong>H1 / TRANSCRIPT.EXE</strong>
      </div>
      <span class="h1-alienados__transcricao-status" data-transcricao-status>
        {temLegenda ? 'CARREGANDO .VTT' : 'SEM ARQUIVO .VTT'}
      </span>
    </div>
    <div class="h1-alienados__transcricao-tela">
      <p class="h1-alienados__transcricao-comando" aria-hidden="true">C:\H1\ALIENADOS\EP_{numero}&gt; transcricao --ao-vivo</p>
      <p class="h1-alienados__transcricao-linha" aria-live="polite" aria-atomic="true">
        <span data-transcricao-texto>Transcrição indisponível</span><span class="h1-alienados__transcricao-cursor" aria-hidden="true">_</span>
      </p>
    </div>
    <div class="h1-alienados__transcricao-rodape">
      <span>ARQUIVO: {temLegenda ? `EP_${numero}.VTT` : 'AGUARDANDO.VTT'}</span>
      <time data-transcricao-tempo>--:-- / --:--</time>
    </div>
  </section>
</div>
