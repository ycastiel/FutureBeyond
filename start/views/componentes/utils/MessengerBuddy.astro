---
/**
 * Avatar social retro inspirado na silhueta dos mensageiros dos anos 2000.
 * Desenho original em SVG: não depende de imagem remota ou JavaScript.
 * Forneça idPrefix único por página para evitar colisão de gradients no SVG.
 */
interface Props {
  className?: string;
  title?: string;
  idPrefix?: string;
}

const {
  className = '',
  title = 'Visitante convidado',
  idPrefix = 'messenger-buddy',
} = Astro.props;

const gradientAzul = `${idPrefix}-azul`;
const gradientVerde = `${idPrefix}-verde`;
const brilho = `${idPrefix}-brilho`;
---

<div class:list={['msn-buddy', className]} role="img" aria-label={title} title={title}>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 128 128" aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id={gradientAzul} x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#d6faff" />
        <stop offset="0.32" stop-color="#59c4ff" />
        <stop offset="0.7" stop-color="#1875de" />
        <stop offset="1" stop-color="#253e9d" />
      </linearGradient>
      <linearGradient id={gradientVerde} x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#e4ffe9" />
        <stop offset="0.3" stop-color="#8fe887" />
        <stop offset="0.7" stop-color="#36b75a" />
        <stop offset="1" stop-color="#168061" />
      </linearGradient>
      <filter id={brilho} x="-40%" y="-40%" width="180%" height="180%">
        <feDropShadow dx="0" dy="3" stdDeviation="3.5" flood-color="#160e45" flood-opacity=".42" />
      </filter>
    </defs>

    <!-- Figura azul ao fundo -->
    <g filter={`url(#${brilho})`}>
      <circle cx="84" cy="43" r="16" fill={`url(#${gradientAzul})`} stroke="#d9f8ff" stroke-width="1.3" />
      <path d="M60 83c0-17 10-28 24-28s24 11 24 28v8c0 6-4 10-10 10H70c-6 0-10-4-10-10z"
        fill={`url(#${gradientAzul})`} stroke="#bbecff" stroke-width="1.4" />
      <path d="M74 33c6-5 13-6 19-1" stroke="#fff" stroke-linecap="round" stroke-width="4" opacity=".43" fill="none" />
    </g>

    <!-- Figura verde à frente -->
    <g filter={`url(#${brilho})`}>
      <circle cx="48" cy="48" r="18" fill={`url(#${gradientVerde})`} stroke="#e9ffea" stroke-width="1.6" />
      <path d="M19 90c0-18 12-30 29-30s29 12 29 30v8c0 7-5 11-12 11H31c-7 0-12-4-12-11z"
        fill={`url(#${gradientVerde})`} stroke="#c4ffdc" stroke-width="1.5" />
      <path d="M37 38c6-6 13-6 19-2" stroke="#fff" stroke-linecap="round" stroke-width="4.4" opacity=".49" fill="none" />
      <path d="M30 76c8-8 25-9 34-2" stroke="#f8ffff" stroke-width="3" opacity=".24" stroke-linecap="round" fill="none" />
    </g>

    <!-- Pequenas estrelas holo, com cara de ícone Y2K -->
    <path d="M107 16l2.4 7.1 7.1 2.4-7.1 2.4-2.4 7.1-2.4-7.1-7.1-2.4 7.1-2.4z" fill="#e7faff" opacity=".93" />
    <path d="M20 22l1.7 5.1 5.1 1.7-5.1 1.7-1.7 5.1-1.7-5.1-5.1-1.7 5.1-1.7z" fill="#f2daff" opacity=".82" />
  </svg>
</div>
