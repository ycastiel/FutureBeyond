{
  "name": "h1-produtora",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev --root ./application --config ./config/astro.config.mjs",
    "check": "astro check --root ./application --config ./config/astro.config.mjs --tsconfig ./config/tsconfig.json",
    "build": "astro build --root ./application --config ./config/astro.config.mjs",
    "preview": "astro preview --root ./application --config ./config/astro.config.mjs",
    "build:preview": "npm run build && npm run preview",
    "astro": "astro"
  },
  "dependencies": {
    "astro": "^7.3.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "typescript": "^6.0.3",
    "wrangler": "^4.151.2"
  }
}
