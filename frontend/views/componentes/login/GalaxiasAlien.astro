---
import '../../../recursos/css/pages/login/galaxias-alien.css';

interface Props {
  /** Video: desenho da arte oficial (1280x720). Entrada: centro dos quadrados/portal. */
  modo?: 'entrada' | 'video';
  /** Habilita o núcleo dourado, usado somente no Benê. */
  dourado?: boolean;
}

const { modo = 'video', dourado = false } = Astro.props;
// Cada SVG tem viewBox 1280x720, igual ao aspecto da imagem usada como fundo.
// A regra preserveAspectRatio="xMidYMid slice" espelha background-size: cover.
const centro = modo === 'entrada' ? { x: 640, y: 360 } : { x: 660, y: 359 };
const lateralEsquerda = modo === 'entrada' ? { x: 240, y: 500 } : { x: 255, y: 505 };
const lateralDireita = modo === 'entrada' ? { x: 1080, y: 225 } : { x: 1120, y: 235 };
---

<!-- Somente decoração: as órbitas não interferem em cliques nem em leitores de tela. -->
<svg
  class:list={['h1-galaxias-alien', `h1-galaxias-alien--${modo}`]}
  viewBox="0 0 1280 720"
  preserveAspectRatio="xMidYMid slice"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <radialGradient id="h1-galaxia-ouro">
      <stop offset="0%" stop-color="#fff2b5" stop-opacity=".34" />
      <stop offset="24%" stop-color="#ffcf79" stop-opacity=".22" />
      <stop offset="56%" stop-color="#e7aa50" stop-opacity=".08" />
      <stop offset="100%" stop-color="#e7aa50" stop-opacity="0" />
    </radialGradient>
    <radialGradient id="h1-galaxia-violeta">
      <stop offset="0%" stop-color="#a4eeff" stop-opacity=".28" />
      <stop offset="50%" stop-color="#a882f8" stop-opacity=".12" />
      <stop offset="100%" stop-color="#a882f8" stop-opacity="0" />
    </radialGradient>
  </defs>

  <!-- Núcleo fixado à roseta do arquivo original: x=660, y=359 no fundo oficial. -->
  <g transform={`translate(${centro.x} ${centro.y})`} class="h1-galaxias-alien__nucleo">
    <circle class="h1-galaxias-alien__aura" r="170" fill={dourado ? 'url(#h1-galaxia-ouro)' : 'url(#h1-galaxia-violeta)'} />
    <g class="h1-galaxias-alien__orbita h1-galaxias-alien__orbita--central">
      <ellipse rx="82" ry="24" transform="rotate(18)" />
      <ellipse rx="61" ry="17" transform="rotate(-41)" />
      <ellipse rx="44" ry="12" transform="rotate(74)" />
      <circle class="h1-galaxias-alien__estrela" cx="78" cy="24" r="3" />
      <circle class="h1-galaxias-alien__estrela" cx="-48" cy="-40" r="2" />
    </g>
  </g>

  <!-- Galáxias laterais: pequenas, com órbitas lentas e linhas delicadas. -->
  <g transform={`translate(${lateralEsquerda.x} ${lateralEsquerda.y})`} class="h1-galaxias-alien__lateral">
    <g class="h1-galaxias-alien__orbita h1-galaxias-alien__orbita--esquerda">
      <ellipse rx="93" ry="31" transform="rotate(-32)" />
      <ellipse rx="63" ry="23" transform="rotate(37)" />
      <ellipse rx="38" ry="13" transform="rotate(91)" />
      <circle class="h1-galaxias-alien__estrela" cx="80" cy="-40" r="3.4" />
      <circle class="h1-galaxias-alien__estrela" cx="-34" cy="-20" r="2" />
    </g>
  </g>
  <g transform={`translate(${lateralDireita.x} ${lateralDireita.y})`} class="h1-galaxias-alien__lateral">
    <g class="h1-galaxias-alien__orbita h1-galaxias-alien__orbita--direita">
      <ellipse rx="100" ry="32" transform="rotate(29)" />
      <ellipse rx="67" ry="24" transform="rotate(-38)" />
      <ellipse rx="41" ry="13" transform="rotate(86)" />
      <circle class="h1-galaxias-alien__estrela" cx="-90" cy="36" r="3" />
      <circle class="h1-galaxias-alien__estrela" cx="42" cy="-21" r="2" />
    </g>
  </g>
</svg>
